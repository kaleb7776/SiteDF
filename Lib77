                    Parent = row
                })
                btn.MouseButton1Click:Connect(function()
                    if listening then return end
                    listening = true
                    keyLbl.Text = "..."
                    local conn
                    conn = UserInputService.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.Keyboard
                           or input.UserInputType == Enum.UserInputType.MouseButton1
                           or input.UserInputType == Enum.UserInputType.MouseButton2 then
                            key = (input.UserInputType == Enum.UserInputType.Keyboard) and input.KeyCode or input.UserInputType
                            keyLbl.Text = key.Name
                            if flag then Library.Flags[flag] = key end
                            listening = false
                            pcall(function() conn:Disconnect() end)
                        end
                    end)
                end)

                UserInputService.InputBegan:Connect(function(input, gp)
                    if gp or listening then return end
                    local k = (input.UserInputType == Enum.UserInputType.Keyboard) and input.KeyCode or input.UserInputType
                    if k == key then pcall(cb) end
                end)

                if flag then Library.Flags[flag] = key end
                return {
                    Set = function(_, v)
                        key = v
                        keyLbl.Text = (key.Name == "None") and "..." or key.Name
                        if flag then Library.Flags[flag] = key end
                    end,
                    Get = function() return key end
                }
            end

