                Position = UDim2.new(0, 2, 0.5, -6),
                BackgroundColor3 = Color3.fromRGB(150, 150, 150),
                BorderSizePixel = 0,
                Parent = headerToggleBtn
            })
            Corner(headerToggleKnob, 6)

            local headerToggleState = false
            local headerToggleBtnClick = Create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
