                        Tween(pickerHolder, 0.2, {Size = UDim2.new(1, 0, 0, 86)})
                    else
                        Tween(pickerHolder, 0.2, {Size = UDim2.new(1, 0, 0, 0)})
                        task.delay(0.2, function() pickerHolder.Visible = false end)
                    end
                end)

                if flag then Library.Flags[flag] = color end
                return {
                    Set = function(_, c)
                        color = c; h, s, v = c:ToHSV()
                        updateColor()
                    end,
                    Get = function() return color end
                }
            end

