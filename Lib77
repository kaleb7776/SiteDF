local NotificationHolder = nil

local function SetupNotifications(parent)
    local gui = Create("ScreenGui", {
        Name = "SketchNotifications",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
    })
    if not gui then return end
    local ok = pcall(function() gui.Parent = CoreGui end)
    if not ok then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

    NotificationHolder = Create("Frame", {
        Name = "Holder",
        Size = UDim2.new(0, 320, 1, -40),
        Position = UDim2.new(1, -330, 0, 20),
        BackgroundTransparency = 1,
        Parent = gui
    })
    Create("UIListLayout", {
        Padding = UDim.new(0, 8),
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = NotificationHolder
    })
end

function Library:Notify(title, text, duration, nType)
    if not NotificationHolder then return end
    duration = duration or 3
    nType = nType or "Info"

    local colors = {
        Info    = Theme.Accent,
        Success = Color3.fromRGB(80, 200, 120),
        Warning = Color3.fromRGB(255, 180, 50),
        Error   = Color3.fromRGB(255, 60, 60),
    }
    local accent = colors[nType] or Theme.Accent

    local note = Create("Frame", {
        Size = UDim2.new(1, 0, 0, 65),
        BackgroundColor3 = Theme.Section,
        BorderSizePixel = 0,
        Parent = NotificationHolder
    })
    Corner(note, 6)
    Stroke(note, Theme.Border)

    local bar = Create("Frame", {
        Size = UDim2.new(0, 3, 1, -12),
        Position = UDim2.new(0, 6, 0, 6),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Parent = note
    })
    Corner(bar, 2)

    Create("TextLabel", {
        Size = UDim2.new(1, -25, 0, 18),
        Position = UDim2.new(0, 16, 0, 8),
        BackgroundTransparency = 1,
        Text = title or "Notificação",
        TextColor3 = Theme.Text,
        TextSize = 13,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = note
    })
    Create("TextLabel", {
        Size = UDim2.new(1, -25, 0, 30),
        Position = UDim2.new(0, 16, 0, 28),
        BackgroundTransparency = 1,
        Text = text or "",
        TextColor3 = Theme.TextDim,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Parent = note
    })

    note.Position = UDim2.new(1, 30, 0, 0)
    Tween(note, 0.3, {Position = UDim2.new(0, 0, 0, 0)})

    task.delay(duration, function()
        if note and note.Parent then
            Tween(note, 0.25, {Position = UDim2.new(1, 30, 0, 0)})
            task.wait(0.3)
            pcall(function() note:Destroy() end)
        end
    end)
end

