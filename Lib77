            -- Slider (barra vermelha)
            function SectionObject:AddSlider(text, min, max, default, flag, cb)
                min = min or 0; max = max or 100
                default = default or min
                cb = cb or function() end
                local value = math.clamp(default, min, max)

                local row = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 28),
                    BackgroundTransparency = 1,
                    Parent = contentHolder
                })
                Create("TextLabel", {
                    Size = UDim2.new(0.6, 0, 0, 14),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = Theme.Text,
                    TextSize = 11,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = row
                })
                local valLbl = Create("TextLabel", {
                    Size = UDim2.new(0.4, 0, 0, 14),
                    Position = UDim2.new(0.6, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(value),
                    TextColor3 = Theme.Accent,
                    TextSize = 11,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Parent = row
                })

                local bg = Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 6),
                    Position = UDim2.new(0, 0, 0, 18),
                    BackgroundColor3 = Theme.SliderBg,
                    BorderSizePixel = 0,
                    Parent = row
                })
                Corner(bg, 3)

                local ratio = (value - min) / (max - min)
                local fill = Create("Frame", {
                    Size = UDim2.new(ratio, 0, 1, 0),
                    BackgroundColor3 = Theme.SliderFill,
                    BorderSizePixel = 0,
                    Parent = bg
                })
                Corner(fill, 3)

                local function update(newVal)
                    value = math.clamp(math.floor(newVal + 0.5), min, max)
                    local r = (value - min) / (max - min)
                    Tween(fill, 0.08, {Size = UDim2.new(r, 0, 1, 0)})
                    valLbl.Text = tostring(value)
                    if flag then Library.Flags[flag] = value end
                    pcall(cb, value)
                end

                local isDragging = false
                local function process(input)
                    local pos = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
                    update(min + pos * (max - min))
                end

                local btn = Create("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = bg
                })
                btn.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                       or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = true
                        process(input)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                                       or input.UserInputType == Enum.UserInputType.Touch) then
                        process(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                       or input.UserInputType == Enum.UserInputType.Touch then
                        isDragging = false
                    end
                end)

                if flag then Library.Flags[flag] = value end
                return {
                    Set = function(_, v) update(v) end,
                    Get = function() return value end
                }
            end

