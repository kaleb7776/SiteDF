            -- Toggle no header da section (aquele toggle do canto)
            local headerToggleBtn = Create("Frame", {
                Name = "HeaderToggle",
                Size = UDim2.new(0, 34, 0, 16),
                Position = UDim2.new(1, -42, 0.5, -8),
                BackgroundColor3 = Theme.ToggleOff,
                BorderSizePixel = 0,
                Parent = header
