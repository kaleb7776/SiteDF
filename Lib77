        local TabObject = {}

        -- Colunas (grid lado a lado)
        function TabObject:AddColumns(count)
            count = count or 2
            local holder = Create("Frame", {
                Name = "Columns",
                Size = UDim2.new(1, -10, 0, 0),
                BackgroundTransparency = 1,
                Parent = tabPage
            })
            local rowLayout = Create("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                Padding = UDim.new(0, 8),
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = holder
            })

            local columns = {}
            for i = 1, count do
                local colFrame = Create("Frame", {
                    Name = "Col" .. i,
                    Size = UDim2.new(1 / count, -((count - 1) * 8) / count, 0, 0),
                    BackgroundTransparency = 1,
                    Parent = holder
                })
                local colLayout = Create("UIListLayout", {
                    Padding = UDim.new(0, 8),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Parent = colFrame
                })
                colLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    colFrame.Size = UDim2.new(1 / count, -((count - 1) * 8) / count, 0, colLayout.AbsoluteContentSize.Y)
                    local maxH = 0
                    for _, c in ipairs(holder:GetChildren()) do
                        if c:IsA("Frame") then
                            local l = c:FindFirstChildOfClass("UIListLayout")
                            if l then maxH = math.max(maxH, l.AbsoluteContentSize.Y) end
                        end
                    end
                    holder.Size = UDim2.new(1, -10, 0, maxH)
                end)

                -- Wrapper que faz AddSection ir pra dentro da coluna
                local colWrap = {}
                function colWrap:AddSection(name, icon)
                    return TabObject._CreateSection(name, icon, colFrame)
                end
                columns[i] = colWrap
            end
            return table.unpack(columns)
        end

